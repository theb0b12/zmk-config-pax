#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp N0
&kp N8  &kp N9
&kp N5  &kp N6  &kp N7
&kp N1  &kp N2  &kp N3  &mo 1
            >;
        };

        layer_1 {
            bindings = <
&bootloader
&trans       &trans
&trans       &trans  &trans
&trans       &trans  &trans  &trans
            >;
        };
    };
};
