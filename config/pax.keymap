#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp N9
&kp N8  &kp N7
&kp N6  &kp N4  &kp N5
&kp N3  &mo 1  &kp N1  &kp N2
            >;
        };

        layer_1 {
            bindings = <
&bootloader
&trans       &trans
&trans       &trans  &trans
&trans       &trans  &trans  &trans
            >;
        };
    };
};